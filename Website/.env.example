# ==============================================================================
# ANYLINK PC BUILDER — ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================
# Copy this file to .env.local and populate the keys below.

# --- Supabase Database & Authentication ---
# Create a free project at https://supabase.com/
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI Extraction Pipeline (Google Gemini API) ---
# Free Tier available at Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# --- Fallback Web Scraping (Firecrawl API) ---
# Free tier (500 credits) available at: https://firecrawl.dev/
FIRECRAWL_API_KEY=your-firecrawl-api-key

# --- Exchange Rate API ---
# Free tier (1,500 requests/month) at: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# --- Application Base URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

